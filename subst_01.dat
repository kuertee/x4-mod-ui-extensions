	} CustomGameStartPosRotPropertyState;
	typedef struct {
		const char* factionid;
		const char* otherfactionid;
		int32_t relation;
	} CustomGameStartRelationInfo;
	typedef struct {
		const char* state;
	} CustomGameStartRelationsPropertyState;
	typedef struct {
		const char* state;
	} CustomGameStartResearchPropertyState;
	typedef struct {
		const char* id;
		const char* name;
		const char* description;
		const char* groupid;
		const char* wareid;
		int32_t index;
		int64_t budgetvalue;
		uint32_t numdependencylists;
	} CustomGameStartStoryInfo;
	typedef struct {
		const char* state;
		uint32_t numvalues;
		uint32_t numdefaultvalues;
	} CustomGameStartStoryState;
	typedef struct {
		const char* state;
		const char* defaultvalue;
		const char* options;
	} CustomGameStartStringPropertyState;
	typedef struct {
		const char* id;
		const char* name;
		int32_t state;
		const char* requiredversion;
		const char* installedversion;
	} InvalidPatchInfo;
	typedef struct {
		const char* id;
		const char* name;
	} ProductionMethodInfo;
	typedef struct {
		const char* macro;
		const char* ware;
		const char* productionmethodid;
	} UIBlueprint;
	typedef struct {
