		{ id = 0, text = ReadText(1001, 4054), icon = "", displayremoveoption = false }, -- none
		{ id = 3, text = ReadText(1001, 4053), icon = "", displayremoveoption = false }, -- high
		{ id = 2, text = ReadText(1001, 4052), icon = "", displayremoveoption = false }, -- medium
