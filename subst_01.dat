function menu.valueGfxFOV()
	local fov = Helper.round(GetFOVOption() * 90)
	local start = nil
	if fov < 60 then
		start = 60
	elseif fov >= 120 then
		start = 120
	else
		start = fov
	end

	local scale = {
		min            = 60,
		max            = 120,
		start          = start,
		step           = 1,
		suffix         = ReadText(1001, 109),
		exceedMaxValue = false,
		hideMaxValue   = true,
	}

	return scale
end

function menu.valueGfxFrameRate()
	local fps = C.GetFrameRateTarget()
	local start = nil
	if fps < 30 then
		start = 30
	elseif fps >= 200 then
		start = 200
	else
		start = fps
	end
	if not C.HasFrameRateLimit() then
		start = config.frameRateLimitOff
	end

	local scale = {
		min            = 30,
		max            = config.frameRateLimitOff,
		start          = start,
		step           = 1,
		suffix         = ReadText(1001, 12779),
		exceedMaxValue = false,
		hideMaxValue   = true,
		infiniteValue  = config.frameRateLimitOff,
		useInfiniteValue = true,
	}

	return scale
end

function menu.isFSREnabled()
	return ((ffi.string(C.GetUpscalingOption(false)) ~= "none") or (ffi.string(C.GetFSRFrameGenOption(false)) ~= "off"))
end

