	else
		Helper.resetUpdateHandler()
		Helper.clearFrame(menu, config.layer)
		Helper.returnFromInteractMenu(menu.currentOverTable, "newmenu", { "EncyclopediaMenu", { 0, 0, mode, library, id, object } })
		menu.cleanup()
